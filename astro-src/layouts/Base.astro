---
import { env } from "cloudflare:workers";
import { getSiteSettingsWithCacheHint } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";

import Motion from "@/components/refresh/Motion.astro";
import CookieNotice from "@/components/site/CookieNotice.astro";
import RefreshFooter from "@/components/refresh/SiteFooter.astro";
import RefreshHeader from "@/components/refresh/SiteHeader.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { isEnabled } from "@/flags";
import { isRefresh } from "@/lib/design";
import { LOCALE_META, resolveLocale, useTranslations } from "@/i18n";
import { resolveSiteIdentity } from "@/utils/site-identity";
import "@/styles/global.css";

/** Link preview image, made by scripts/og/build-og-image.ts. */
const OG_IMAGE = { path: "/brand/genes-consulting-og.png", width: 1200, height: 630, type: "image/png" };

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Content reference for EmDash page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// design_refresh (editors only until released): new header, footer, motion and page transitions.
const refresh = isRefresh(env, Astro.locals.user);
const Header = refresh ? RefreshHeader : SiteHeader;
const Footer = refresh ? RefreshFooter : SiteFooter;
// cookie_notice (editors only until released): cookie notice and the footer's legal row.
const legal = isEnabled("cookie_notice", env, Astro.locals.user);

const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);

const { siteTitle, siteTagline, siteLogo } = resolveSiteIdentity(settingsResult.data, {
	title: t("site.name"),
	tagline: t("seo:defaultDescription"),
});
const separator = t("seo:titleSeparator");
// A title that already names the site (alone, first or last) is used as is.
const namesSite =
	title === siteTitle || title.startsWith(`${siteTitle}${separator}`) || title.endsWith(`${separator}${siteTitle}`);
const fullTitle = namesSite ? title : `${title}${separator}${siteTitle}`;

// Link previews (WhatsApp, LinkedIn, email...): scrapers need absolute URLs, so the page URL
// defaults to this request's address without the query string (drops ?_preview and the like).
const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.url.origin).href;
// An image set in EmDash wins: the page's SEO panel (applied inside EmDashHead) or the site
// settings' default SEO image. Without either, the brand card from public/brand.
const editorImage = image || settingsResult.data.seo?.defaultOgImage?.url;
const brandCard = editorImage ? null : new URL(OG_IMAGE.path, Astro.url.origin).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: description ?? siteTagline,
	canonical: pageUrl,
	image: image ?? brandCard,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<meta property="og:locale" content={LOCALE_META[locale].og} />
		<link rel="icon" href="/brand/genes-consulting-logo.svg" type="image/svg+xml" />
		<link rel="icon" href="/brand/genes-consulting-logo.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/brand/genes-consulting-touch.png" sizes="180x180" />
		{
			brandCard && (
				<>
					<meta property="og:image:width" content={String(OG_IMAGE.width)} />
					<meta property="og:image:height" content={String(OG_IMAGE.height)} />
					<meta property="og:image:type" content={OG_IMAGE.type} />
					<meta property="og:image:alt" content={t("seo:ogImageAlt")} />
					<meta name="twitter:image:alt" content={t("seo:ogImageAlt")} />
				</>
			)
		}
		<title>{fullTitle}</title>
		<!--
			Light/dark: follows the system setting live unless the visitor picked
			light or dark in the footer toggle (localStorage "theme", see lib/theme.ts).
			Inline so the page never flashes the wrong theme.
		-->
		<script is:inline>
			(() => {
				const mq = window.matchMedia("(prefers-color-scheme: dark)");
				const apply = () => {
					let t = null;
					try { t = localStorage.getItem("theme"); } catch {}
					const dark = t === "dark" || (t !== "light" && mq.matches);
					document.documentElement.classList.toggle("dark", dark);
					// Native controls and scrollbars follow the chosen theme, not only the OS.
					document.documentElement.style.colorScheme = dark ? "dark" : "light";
				};
				apply();
				mq.addEventListener("change", apply);
			})();
		</script>
		{
			refresh && (
				/* Native cross-document view transitions: a soft cross-fade between pages, no JS. */
				<style is:inline>
					@media (prefers-reduced-motion: no-preference) {
						@view-transition {
							navigation: auto;
						}
					}
				</style>
			)
		}
		<EmDashHead page={pageCtx} />
	</head>
	<body class="flex min-h-svh flex-col">
		<EmDashBodyStart page={pageCtx} />
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-background focus:p-2"
		>
			{t("site.skipToContent")}
		</a>
		<Header siteTitle={siteTitle} siteLogo={siteLogo} />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer siteTitle={siteTitle} siteTagline={siteTagline} showLegal={legal} />
		{legal && <CookieNotice />}
		{refresh && <Motion />}
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
