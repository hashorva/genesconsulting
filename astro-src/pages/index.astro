---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Waypoints } from "lucide-react";

import PostCard from "@/components/blog/PostCard.astro";
import RichText from "@/components/content/RichText.astro";
import PageBlocks from "@/components/blocks/PageBlocks.astro";
import { buttonVariants } from "@/components/ui/button";
import { resolveLocale, useTranslations } from "@/i18n";
import { routePath } from "@/i18n/routes";
import { pageLink } from "@/lib/content-links";
import Base from "@/layouts/Base.astro";
import { resolveSiteIdentity } from "@/utils/site-identity";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Copy comes from EmDash: site settings (title, tagline) and the optional "home" page body.
const [{ entry: home, cacheHint: homeHint }, { entries: posts, cacheHint: postsHint }, settings] =
	await Promise.all([
		getEmDashEntry("pages", "home", { locale }),
		getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 3, locale }),
		getSiteSettings(),
	]);
if (Astro.cache?.enabled) {
	if (home) Astro.cache.set(homeHint);
	Astro.cache.set(postsHint);
}
// Buttons only link to pages that are published.
const [contactHref, servicesHref] = await Promise.all([
	pageLink(Astro, "page.contact", locale),
	pageLink(Astro, "page.services", locale),
]);
const { siteTitle, siteTagline } = resolveSiteIdentity(settings, {
	title: t("site.name"),
	tagline: t("seo:defaultDescription"),
});
---

<Base title={siteTitle} description={siteTagline}>
	<section class="bg-primary text-primary-foreground dark:bg-background dark:text-foreground">
		<div class="container mx-auto grid items-center gap-10 px-4 py-16 md:grid-cols-3 md:px-6 md:py-24">
			<div class="space-y-6 md:col-span-2">
				<h1 class="text-4xl font-bold tracking-tight md:text-6xl">{home?.data.title ?? siteTitle}</h1>
				<p class="text-lg opacity-90 md:text-xl">{siteTagline}</p>
				{
					(contactHref || servicesHref) && (
						<div class="flex flex-wrap gap-3">
							{contactHref && (
								<a href={contactHref} class={buttonVariants({ variant: "secondary", size: "lg" })}>
									{t("nav.cta")}
								</a>
							)}
							{servicesHref && (
								<a href={servicesHref} class={buttonVariants({ variant: "ghost", size: "lg" })}>
									{t("actions.discoverServices")}
								</a>
							)}
						</div>
					)
				}
			</div>
			<Waypoints aria-hidden="true" className="hidden size-48 justify-self-center text-sky-400 md:block" />
		</div>
	</section>

	{
		home?.data.content && (
			<section class="container mx-auto px-4 py-16 md:px-6 md:py-24">
				<RichText value={home.data.content} class="max-w-3xl" />
			</section>
		)
	}

	{
		home?.data.layout && home.data.layout.length > 0 && (
			<div class="container mx-auto px-4 pb-16 md:px-6 md:pb-24">
				<PageBlocks value={home.data.layout} />
			</div>
		)
	}

	{
		posts.length > 0 && (
			<section class="container mx-auto space-y-8 px-4 py-16 md:px-6 md:py-24">
				<div class="flex items-end justify-between gap-4">
					<h2 class="text-3xl font-bold tracking-tight md:text-4xl">{t("blog:title")}</h2>
					<a href={routePath("page.updates", locale)} class={buttonVariants({ variant: "link" })}>
						{t("actions.readMore")}
					</a>
				</div>
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			</section>
		)
	}
</Base>
