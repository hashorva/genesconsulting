---
import { decodeSlug, getEmDashEntry } from "emdash";

import PageView from "@/components/content/PageView.astro";
import { resolveLocale } from "@/i18n";
import { SERVICE_PREFIX, servicePathFromSlug } from "@/lib/page-paths";

// Single-segment pages from the EmDash "pages" collection: /chi-siamo/, /contatti/, ...
const slug = decodeSlug(Astro.params.slug);
if (!slug || slug === "home") return Astro.rewrite("/404/");

// Service pages live under /servizi/<name>/ (page slug "servizi-<name>"): one URL per page.
if (slug.startsWith(SERVICE_PREFIX)) return Astro.redirect(servicePathFromSlug(slug), 301);

const locale = resolveLocale(Astro.currentLocale);
const { entry: page, cacheHint } = await getEmDashEntry("pages", slug, { locale });
if (!page) return Astro.rewrite("/404/");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<PageView page={page} slug={slug} />
