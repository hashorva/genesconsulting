---
import { getEmDashCollection } from "emdash";

import PostCard from "@/components/blog/PostCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { resolveLocale, useTranslations } from "@/i18n";
import { routePath } from "@/i18n/routes";
import Base from "@/layouts/Base.astro";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
	locale,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const base = routePath("page.updates", locale);
---

<Base title={t("blog:title")} description={t("blog:description")}>
	<section class="container mx-auto space-y-10 px-4 py-16 md:px-6 md:py-24">
		<header class="max-w-3xl space-y-4">
			<h1 class="text-3xl font-bold tracking-tight md:text-4xl">{t("blog:title")}</h1>
			<p class="text-lg text-muted-foreground md:text-xl">{t("blog:description")}</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="text-muted-foreground">{t("blog:empty")}</p>
			) : (
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			)
		}

		<nav aria-label={t("blog:pagination.label")} class="flex gap-3">
			{cursor && <a href={base} class={buttonVariants({ variant: "outline" })}>{t("blog:pagination.first")}</a>}
			{
				nextCursor && (
					<a href={`${base}?cursor=${encodeURIComponent(nextCursor)}`} class={buttonVariants({ variant: "outline" })}>
						{t("blog:pagination.next")}
					</a>
				)
			}
		</nav>
	</section>
</Base>
