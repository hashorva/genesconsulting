---
import SiteLogo from "@/components/site/SiteLogo.astro";

interface Props {
	siteTitle: string;
	/** Logo uploaded in EmDash site settings; replaces the built-in mark. */
	siteLogo?: { url?: string; alt?: string } | null;
	/** "md": navbar. "sm": footer. */
	size?: "md" | "sm";
}

const { siteTitle, siteLogo = null, size = "md" } = Astro.props;

// Logo on the left. On the right, two lines that together are as tall as the logo:
// the first word ("GENES") bold at about 2/3 of the logo height, the rest ("CONSULTING")
// light at about 1/3 of it, in the terminal's yellow (one shade darker on light backgrounds for AA contrast). The name stays live text.
const [first, ...rest] = siteTitle.trim().split(/\s+/);
const second = rest.join(" ");

const logoClass = size === "md" ? "size-10" : "size-8";
const firstClass = size === "md" ? "text-2xl" : "text-xl";
const secondClass = size === "md" ? "text-sm" : "text-xs";
---

<span class="flex items-center gap-2">
	{
		siteLogo ? (
			<img src={siteLogo.url} alt={siteLogo.alt || ""} class={logoClass} />
		) : (
			<SiteLogo class={logoClass} />
		)
	}
	<span class="flex flex-col justify-center leading-none">
		<span class={`font-bold uppercase text-foreground ${firstClass}`}>{first}</span>
		{
			second && (
				<span class={`font-light uppercase tracking-widest text-yellow-700 dark:text-yellow-600 ${secondClass}`}>{second}</span>
			)
		}
	</span>
</span>
