---
import { Menu, Waypoints, X } from "lucide-react";

import { buttonVariants } from "@/components/ui/button";
import { resolveLocale, useTranslations } from "@/i18n";
import { routePath, type RouteKey } from "@/i18n/routes";
import { cn } from "@/lib/utils";

interface Props {
	siteTitle: string;
	siteLogo: { url?: string; alt?: string } | null;
}

const { siteTitle, siteLogo } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Labels are interface strings (i18n); the pages behind them are EmDash content.
const items: { key: RouteKey; label: string }[] = [
	{ key: "page.about", label: t("nav.about") },
	{ key: "page.services", label: t("nav.services") },
	{ key: "audience.businesses", label: t("nav.forBusinesses") },
	{ key: "audience.firms", label: t("nav.forFirms") },
	{ key: "page.updates", label: t("nav.updates") },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== "/" && current.startsWith(href));
---

<header class="sticky top-0 z-40 border-b bg-background/90 backdrop-blur">
	<div class="container mx-auto flex h-16 items-center justify-between gap-4 px-4 md:px-6">
		<a href={routePath("page.home", locale)} class="flex items-center gap-2 font-semibold tracking-tight">
			{
				siteLogo ? (
					<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="h-8 w-auto" />
				) : (
					<>
						{/* Placeholder until the real SVG logo exists (upload it in EmDash settings). */}
						<Waypoints aria-hidden="true" className="size-6 text-sky-700 dark:text-sky-400" />
						<span>{siteTitle}</span>
					</>
				)
			}
		</a>

		<nav aria-label={t("nav.label")} class="hidden items-center gap-1 lg:flex">
			{
				items.map(({ key, label }) => {
					const href = routePath(key, locale);
					return (
						<a
							href={href}
							aria-current={isCurrent(href) ? "page" : undefined}
							class={cn(buttonVariants({ variant: "ghost" }), "aria-[current=page]:text-primary")}
						>
							{label}
						</a>
					);
				})
			}
			<a href={routePath("page.contact", locale)} class={cn(buttonVariants(), "ml-2")}>{t("nav.cta")}</a>
		</nav>

		<!-- Mobile menu: native disclosure, no JS. To be replaced by shadcn Sheet (side="right"). -->
		<details class="group lg:hidden">
			<summary
				class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "list-none [&::-webkit-details-marker]:hidden")}
				aria-label={t("nav.openMenu")}
			>
				<Menu className="group-open:hidden" />
				<X className="hidden group-open:block" />
			</summary>
			<nav
				aria-label={t("nav.label")}
				class="absolute inset-x-0 top-16 flex flex-col gap-1 border-b bg-background p-4 shadow-lg"
			>
				{
					items.map(({ key, label }) => {
						const href = routePath(key, locale);
						return (
							<a
								href={href}
								aria-current={isCurrent(href) ? "page" : undefined}
								class={cn(buttonVariants({ variant: "ghost", size: "lg" }), "justify-start")}
							>
								{label}
							</a>
						);
					})
				}
				<a href={routePath("page.contact", locale)} class={cn(buttonVariants({ size: "lg" }), "mt-2")}>{t("nav.cta")}</a>
			</nav>
		</details>
	</div>
</header>
