---
import { Menu, X } from "lucide-react";

import SiteBrand from "@/components/site/SiteBrand.astro";

import { buttonVariants } from "@/components/ui/button";
import { resolveLocale, useTranslations } from "@/i18n";
import { routePath } from "@/i18n/routes";
import { menuItems, pageLink } from "@/lib/content-links";
import { cn } from "@/lib/utils";

interface Props {
	siteTitle: string;
	siteLogo: { url?: string; alt?: string } | null;
}

const { siteTitle, siteLogo } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Navigation is the EmDash "primary" menu: editors add an item once its page is published,
// so production never links to pages that do not exist yet.
const [items, contactHref] = await Promise.all([
	menuItems(Astro, "primary", locale),
	pageLink(Astro, "page.contact", locale),
]);
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== "/" && current.startsWith(href));
const hasNav = items.length > 0 || contactHref !== null;
---

<header class="sticky top-0 z-40 border-b bg-background/90 backdrop-blur">
	<div class="container mx-auto flex h-16 items-center justify-between gap-4 px-4 md:px-6">
		<a href={routePath("page.home", locale)} aria-label={siteTitle}>
			<SiteBrand siteTitle={siteTitle} siteLogo={siteLogo} />
		</a>

		{
			hasNav && (
				<nav aria-label={t("nav.label")} class="hidden items-center gap-1 lg:flex">
					{items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={isCurrent(item.url) ? "page" : undefined}
							class={cn(buttonVariants({ variant: "ghost" }), "aria-[current=page]:text-primary")}
						>
							{item.label}
						</a>
					))}
					{contactHref && (
						<a href={contactHref} class={cn(buttonVariants(), "ml-2")}>
							{t("nav.cta")}
						</a>
					)}
				</nav>
			)
		}

		{
			hasNav && (
				<details class="group lg:hidden">
					{/* Mobile menu: native disclosure, no JS. To be replaced by shadcn Sheet (side="right"). */}
					<summary
						class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "list-none [&::-webkit-details-marker]:hidden")}
						aria-label={t("nav.openMenu")}
					>
						<Menu className="group-open:hidden" />
						<X className="hidden group-open:block" />
					</summary>
					<nav
						aria-label={t("nav.label")}
						class="absolute inset-x-0 top-16 flex flex-col gap-1 border-b bg-background p-4 shadow-lg"
					>
						{items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={isCurrent(item.url) ? "page" : undefined}
								class={cn(buttonVariants({ variant: "ghost", size: "lg" }), "justify-start")}
							>
								{item.label}
							</a>
						))}
						{contactHref && (
							<a href={contactHref} class={cn(buttonVariants({ size: "lg" }), "mt-2")}>
								{t("nav.cta")}
							</a>
						)}
					</nav>
				</details>
			)
		}
	</div>
</header>
