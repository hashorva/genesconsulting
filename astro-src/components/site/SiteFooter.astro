---
import SiteBrand from "@/components/site/SiteBrand.astro";
import LegalBar from "@/components/site/LegalBar.astro";
import ThemeToggle from "@/components/site/ThemeToggle";
import { resolveLocale, useTranslations } from "@/i18n";
import { menuItems } from "@/lib/content-links";

interface Props {
	siteTitle: string;
	siteTagline: string;
	/** Flag cookie_notice: show the legal row (company data, policies, cookie preferences). */
	showLegal?: boolean;
}

const { siteTitle, siteTagline, showLegal = false } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
// Legal links come from the EmDash "footer" menu, added once those pages are published.
const items = await menuItems(Astro, "footer", locale);
---

<footer class="border-t text-muted-foreground">
	<div class="container mx-auto grid gap-8 px-4 py-12 md:grid-cols-2 md:px-6">
		<div class="space-y-2">
			<SiteBrand siteTitle={siteTitle} size="sm" />
			<p class="text-sm">{siteTagline}</p>
		</div>
		{
			items.length > 0 && (
				<nav aria-label={t("footer.legal")} class="flex flex-wrap gap-x-6 gap-y-2 text-sm md:justify-end">
					{items.map((item) => (
						<a class="hover:text-foreground" href={item.url}>
							{item.label}
						</a>
					))}
				</nav>
			)
		}
	</div>
	{showLegal && (
		<div class="container mx-auto px-4 md:px-6">
			<LegalBar />
		</div>
	)}
	<div class="container mx-auto flex flex-wrap items-center justify-between gap-4 px-4 pb-8 text-xs md:px-6">
		<p>{t("footer.copyright", { year, name: siteTitle })}</p>
		<ThemeToggle
			client:idle
			labels={{ group: t("theme.label"), light: t("theme.light"), system: t("theme.system"), dark: t("theme.dark") }}
		/>
	</div>
</footer>
