---
interface Props {
	alt?: string;
	class?: string;
}

// One logo for light and dark: the mark alone, transparent. The site name is live text set beside it by the caller.
const { alt = "", class: className } = Astro.props;
---

{/* SVG with a PNG fallback. */}
<picture class:list={["block", className]}>
	<source srcset="/brand/logo.svg" type="image/svg+xml" />
	<img src="/brand/logo.png" alt={alt} class="size-full" />
</picture>
