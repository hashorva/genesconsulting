---
interface Props {
	alt?: string;
	class?: string;
}

// The mark stands alone; the site name is live text set beside it by the caller.
const { alt = "", class: className } = Astro.props;
---

{/* SVG with a PNG fallback. Light and dark artwork swap with Tailwind's dark variant (follows the footer toggle). */}
<picture class:list={["block dark:hidden", className]}>
	<source srcset="/brand/mark-light.svg" type="image/svg+xml" />
	<img src="/brand/mark-light.png" alt={alt} class="size-full" />
</picture>
<picture class:list={["hidden dark:block", className]}>
	<source srcset="/brand/mark-dark.svg" type="image/svg+xml" />
	<img src="/brand/mark-dark.png" alt={alt} class="size-full" />
</picture>
