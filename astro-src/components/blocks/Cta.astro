---
import { buttonVariants } from "@/components/ui/button";
import type { PageLayoutCtaBlock } from "../../../emdash-env";

/** "Invito all'azione": closing panel with one button (brand-colors.md: Button default, size lg). */
interface Props {
	value: PageLayoutCtaBlock;
}
const { value } = Astro.props;
---

<section class="space-y-4 rounded-2xl bg-muted p-8 md:p-12">
	<h2 class="text-2xl font-bold tracking-tight md:text-3xl">{value.heading}</h2>
	{value.text && <p class="max-w-2xl leading-relaxed text-muted-foreground">{value.text}</p>}
	{
		value.button_url && (
			<a href={value.button_url} class={buttonVariants({ size: "lg" })}>
				{value.button_label || value.heading}
			</a>
		)
	}
</section>
