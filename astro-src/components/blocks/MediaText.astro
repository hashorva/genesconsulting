---
import { Image } from "emdash/ui";

import ButtonList from "@/components/blocks/ButtonList.astro";
import RichText from "@/components/content/RichText.astro";
import { pick } from "@/lib/section-style";
import { cn } from "@/lib/utils";
import type { PageLayoutMediaTextBlock } from "../../../emdash-env";

/** "Testo e immagine": title, rich text and buttons beside one image (left or right on wide screens). */
interface Props {
	value: PageLayoutMediaTextBlock;
}
const { value } = Astro.props;
const imageLeft = pick("imageSide", value.image_side, "Destra") === "Sinistra";
---

<section class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
	<div class={cn("space-y-6", imageLeft && "md:order-2")}>
		{value.heading && <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{value.heading}</h2>}
		{value.content && <RichText value={value.content} />}
		<ButtonList buttons={value.buttons} />
	</div>
	{value.image?.id && <Image image={value.image} class="w-full rounded-2xl object-cover" />}
</section>
