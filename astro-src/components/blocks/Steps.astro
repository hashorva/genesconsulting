---
import SectionHeading from "@/components/blocks/SectionHeading.astro";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import type { PageLayoutStepsBlock } from "../../../emdash-env";

/** "Passaggi": numbered step cards (brand-colors.md: number as text-2xl font-bold, cyan). */
interface Props {
	value: PageLayoutStepsBlock;
}
const { value } = Astro.props;
---

<section class="@container space-y-6">
	<SectionHeading heading={value.heading} intro={value.intro} />
	<ol class="grid gap-4 @xl:grid-cols-2 @4xl:grid-cols-4">
		{
			value.steps.map((step, index) => (
				<li class="flex">
					<Card className="w-full">
						<CardHeader>
							<span aria-hidden="true" class="text-2xl font-bold text-sky-700 dark:text-sky-300">
								{String(index + 1).padStart(2, "0")}
							</span>
							<CardTitle>
								<h3 class="text-lg font-semibold">{step.title}</h3>
							</CardTitle>
							{step.text && <CardDescription className="leading-relaxed">{step.text}</CardDescription>}
						</CardHeader>
					</Card>
				</li>
			))
		}
	</ol>
</section>
