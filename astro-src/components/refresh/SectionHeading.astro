---
import Eyebrow from "@/components/refresh/Eyebrow.astro";
import { cn } from "@/lib/utils";

/**
 * Section title in the redesign: the deck's eyebrow (the section's number, or a label),
 * a large heading, and the intro beside it on wide screens (editorial split).
 */
interface Props {
	heading?: string | null;
	intro?: string | null;
	eyebrow?: string | null;
	centered?: boolean;
	class?: string;
}
const { heading, intro, eyebrow, centered = false, class: className } = Astro.props;
---

{
	(heading || intro) && (
		<div
			data-reveal
			class={cn(
				"grid gap-6",
				!centered && heading && intro && "lg:grid-cols-12 lg:items-end lg:gap-12",
				centered && "mx-auto max-w-3xl text-center",
				className,
			)}
		>
			<div class={cn("space-y-5", !centered && intro && "lg:col-span-7")}>
				{eyebrow && <Eyebrow text={eyebrow} class={cn(centered && "justify-center")} />}
				{heading && <h2 class="text-3xl font-semibold tracking-tight text-balance md:text-4xl lg:text-5xl">{heading}</h2>}
			</div>
			{intro && (
				<p class={cn("text-lg leading-relaxed text-pretty text-muted-foreground", !centered && heading && "lg:col-span-5")}>
					{intro}
				</p>
			)}
		</div>
	)
}
