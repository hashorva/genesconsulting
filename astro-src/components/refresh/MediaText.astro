---
import { Image } from "emdash/ui";

import ButtonList from "@/components/blocks/ButtonList.astro";
import RichText from "@/components/content/RichText.astro";
import Eyebrow from "@/components/refresh/Eyebrow.astro";
import { pick } from "@/lib/section-style";
import { cn } from "@/lib/utils";
import type { PageLayoutMediaTextBlock } from "../../../emdash-env";

/**
 * "Testo e immagine" in the redesign: numbered eyebrow and large heading beside the image,
 * which sits in a rounded frame with a faint cyan ring and a soft glow behind it.
 */
interface Props {
	value: PageLayoutMediaTextBlock;
	eyebrow?: string | null;
}
const { value, eyebrow } = Astro.props;
const imageLeft = pick("imageSide", value.image_side, "Destra") === "Sinistra";
---

<section class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
	<div data-reveal class={cn("space-y-6", imageLeft && "lg:order-2")}>
		{eyebrow && <Eyebrow text={eyebrow} />}
		{value.heading && <h2 class="text-3xl font-semibold tracking-tight text-balance md:text-4xl lg:text-5xl">{value.heading}</h2>}
		{value.content && <RichText value={value.content} class="text-lg" />}
		<ButtonList buttons={value.buttons} />
	</div>
	{
		value.image?.id && (
			<div data-reveal class="relative delay-150">
				<div aria-hidden="true" class="absolute -inset-6 -z-10 rounded-full bg-sky-400/15 blur-3xl" />
				<Image image={value.image} class="w-full rounded-3xl object-cover ring-1 ring-sky-400/20" />
			</div>
		)
	}
</section>
