---
import { ArrowRight, Menu, X } from "lucide-react";

import SiteBrand from "@/components/site/SiteBrand.astro";
import { buttonVariants } from "@/components/ui/button";
import { resolveLocale, useTranslations } from "@/i18n";
import { routePath } from "@/i18n/routes";
import { menuItems, pageLink } from "@/lib/content-links";
import { cn } from "@/lib/utils";

/**
 * Header of the redesign: always on the dark brand colour (like the deck), frosted once
 * the page scrolls (data-scrolled, set by Motion.astro). Links get a cyan underline that
 * grows from the left on hover and stays under the current page.
 */
interface Props {
	siteTitle: string;
	siteLogo: { url?: string; alt?: string } | null;
}

const { siteTitle, siteLogo } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const [items, contactHref] = await Promise.all([
	menuItems(Astro, "primary", locale),
	pageLink(Astro, "page.contact", locale),
]);
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== "/" && current.startsWith(href));
const hasNav = items.length > 0 || contactHref !== null;
const link =
	"relative px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:text-white aria-[current=page]:text-white " +
	"after:absolute after:inset-x-3 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-sky-400 after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100";
---

<header
	data-site-header
	class="dark sticky top-0 z-40 border-b border-transparent bg-sky-950 text-foreground transition-colors duration-300 data-scrolled:border-sky-400/10 data-scrolled:bg-sky-950/85 data-scrolled:backdrop-blur-md"
>
	<div class="container mx-auto flex h-16 items-center justify-between gap-4 px-4 md:h-20 md:px-6">
		<a href={routePath("page.home", locale)} aria-label={siteTitle} class="rounded-md outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
			<SiteBrand siteTitle={siteTitle} siteLogo={siteLogo} />
		</a>

		{
			hasNav && (
				<nav aria-label={t("nav.label")} class="hidden items-center gap-1 lg:flex">
					{items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={isCurrent(item.url) ? "page" : undefined}
							class={link}
						>
							{item.label}
						</a>
					))}
					{contactHref && (
						<a href={contactHref} class={cn(buttonVariants(), "group ml-4")}>
							{t("nav.cta")}
							<ArrowRight data-icon="inline-end" className="transition-transform group-hover:translate-x-0.5" />
						</a>
					)}
				</nav>
			)
		}

		{
			hasNav && (
				<details class="group lg:hidden">
					<summary
						class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "list-none [&::-webkit-details-marker]:hidden")}
						aria-label={t("nav.openMenu")}
					>
						<Menu className="group-open:hidden" />
						<X className="hidden group-open:block" />
					</summary>
					<nav
						aria-label={t("nav.label")}
						class="absolute inset-x-0 top-16 flex flex-col gap-1 border-b border-sky-400/10 bg-sky-950 p-4 shadow-2xl group-open:animate-in group-open:fade-in group-open:slide-in-from-top-2 md:top-20"
					>
						{items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={isCurrent(item.url) ? "page" : undefined}
								class="rounded-lg px-3 py-3 text-lg font-medium text-slate-200 hover:bg-sky-900 aria-[current=page]:text-sky-400"
							>
								{item.label}
							</a>
						))}
						{contactHref && (
							<a href={contactHref} class={cn(buttonVariants({ size: "lg" }), "mt-3")}>
								{t("nav.cta")}
							</a>
						)}
					</nav>
				</details>
			)
		}
	</div>
</header>
