# Critical paths: a PR that touches any of these needs an approving review from the owner.
# Enforced by GitHub itself (ruleset on main: "Require review from Code Owners"), always from
# main's copy of this file, so a PR cannot loosen its own requirement or its own workflows.
# Agents work as a separate bot account (docs/github-bot-setup.md) and cannot approve.
# Keep in sync with RISKY_PATHS in .github/workflows/ai-review.yml (same paths, glob syntax).

# Workflows, this file, review prompt
/.github/                       @hashorva

# Agent rules and rule docs
/AGENTS.md                      @hashorva
/CLAUDE.md                      @hashorva
/docs/cd.md                     @hashorva
/docs/design/brand-colors.md    @hashorva
/docs/github-bot-setup.md       @hashorva
/.agents/                       @hashorva
/.claude/                       @hashorva
/.mcp.json                      @hashorva

# Deploy, build and dependencies
wrangler*.jsonc                 @hashorva
wrangler*.toml                  @hashorva
/astro.config.*                 @hashorva
/package.json                   @hashorva
/package-lock.json              @hashorva
/bun.lock                       @hashorva
/bun.lockb                      @hashorva

# Flags, EmDash schema and migrations
/flags.json                     @hashorva
/seed/                          @hashorva
migration/                      @hashorva
migrations/                     @hashorva
*emdash-migrate*                @hashorva
/astro-src/flags.ts             @hashorva
/astro-src/worker.ts            @hashorva

# Auth, session and middleware files or folders
auth*.ts                        @hashorva
auth*.js                        @hashorva
auth*.mjs                       @hashorva
auth*.astro                     @hashorva
session*.ts                     @hashorva
session*.js                     @hashorva
session*.mjs                    @hashorva
session*.astro                  @hashorva
middleware*.ts                  @hashorva
middleware*.js                  @hashorva
middleware*.mjs                 @hashorva
middleware*.astro               @hashorva
auth/                           @hashorva
session/                        @hashorva
middleware/                     @hashorva
