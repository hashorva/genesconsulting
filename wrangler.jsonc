{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Production Worker = the client's preview site. Their domain is attached later (see docs/cloudflare-setup.md).
	"name": "genesconsulting",
	"main": "./astro-src/worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Keep variables set in the Cloudflare dashboard (FLAG_<NAME> kill switches) across deploys.
	"keep_vars": true,

	// HARD RULE (docs/cd.md): never rename, delete or recreate these bindings or resource names.
	// They hold the live EmDash content. Wrangler creates them on the first deploy.
	"d1_databases": [{ "binding": "DB", "database_name": "genesconsulting" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "genesconsulting-media" }],
	// Astro sessions (EmDash admin login). Provisioned automatically on deploy.
	"kv_namespaces": [{ "binding": "SESSION" }],
	// EmDash scheduled publishing, plugin tasks and maintenance.
	"triggers": { "crons": ["* * * * *"] },

	"vars": {
		"ENVIRONMENT": "production"
		// After the client's domain is live, add: "EMDASH_SITE_URL": "https://www.genesconsulting.it"
		// (passkeys only work on the origin recorded at setup; read docs/cloudflare-setup.md first).
	},
	// Secret (never in this file): EMDASH_ENCRYPTION_KEY, set with `wrangler secret put` per environment.

	"env": {
		// Shared preview Worker for pull requests: its own database, bucket and KV.
		// Never points at production content. Built with CLOUDFLARE_ENV=preview.
		"preview": {
			"name": "genesconsulting-preview",
			"d1_databases": [{ "binding": "DB", "database_name": "genesconsulting-preview" }],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "genesconsulting-media-preview" }],
			"kv_namespaces": [{ "binding": "SESSION" }],
			"triggers": { "crons": [] },
			"vars": { "ENVIRONMENT": "preview" }
		}
	}
}
