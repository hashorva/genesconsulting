{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./astro-src/*"]
		}
	},
	"include": ["astro-src", "tests", ".astro/types.d.ts", "emdash-env.d.ts", "worker-configuration.d.ts"],
	"exclude": ["dist", "node_modules"]
}
